# Copy to .env.local (ignored by Git). Keep all values empty in version control.
# Use the confirmed ABAAD EXHIBIT project's URL and PUBLISHABLE key only.
# Never paste sb_secret_* or a service_role JWT into ANY NEXT_PUBLIC_* variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Recommended: pin the approved hosted project reference (not its display name).
# When set, a URL for a different project is rejected. Custom domains need a reviewed config adjustment.
SUPABASE_EXPECTED_PROJECT_REF=

# Protocol exhibition selection (server only)
SUPABASE_EXHIBITION_SLUG=naima-baghdad-2026
# Cloudinary references only; no uploads in this phase.
CLOUDINARY_CLOUD_NAME=
# public for public assets, authenticated for private authenticated assets.
CLOUDINARY_DELIVERY_MODE=public
# SERVER ONLY; required solely for authenticated delivery. Never prefix with NEXT_PUBLIC_.
CLOUDINARY_API_SECRET=
